[Unit]
Description=http2k daemon (x2kafka)
After=network.target kafka.service

[Service]
Type=simple
User=<%= @user %>
Group=<%= @group %>
RuntimeDirectory=http2k
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/x2kafka /etc/http2k/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
